{
  "name": "weave-operational-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build && esbuild src/server/main.ts src/server/migrate.ts src/server/seed.ts src/server/worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/main.js",
    "worker": "node dist/server/worker.js",
    "migrate": "tsx src/server/migrate.ts",
    "seed": "tsx src/server/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^1.13.0",
    "ajv": "^8.17.0",
    "exceljs": "^4.4.0",
    "hono": "^4.6.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
