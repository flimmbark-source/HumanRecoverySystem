# --- Required ---
DATABASE_URL=postgres://weave:weave@localhost:5432/weave
SESSION_SECRET=change-me-to-a-long-random-string
PORT=8787

# --- Optional ---
# Set to 0 only for plain-http local use. Production behind TLS should keep the default (1).
COOKIE_SECURE=0
# Allow self-service account creation. Set to 0 after the pilot team has signed up.
ALLOW_SIGNUP=1
# Max JSON body accepted by the API, in bytes (imports included).
MAX_BODY_BYTES=2000000

# --- Research provider ---
# none      : no agent jobs; capture, manual review and candidate import still work
# anthropic : real provider (Claude with public web search for wide jobs)
# fixture   : deterministic synthetic output, visibly labelled, for demos and tests only
RESEARCH_PROVIDER=none
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-opus-5-5
# Per-job wall clock budget (seconds), attempts, and the cap on web searches for one wide job.
RESEARCH_BUDGET_SECONDS=300
RESEARCH_MAX_ATTEMPTS=2
RESEARCH_MAX_SEARCHES=6
# Run the job worker inside the web process (1) or separately with `npm run worker` (0).
RUN_WORKER=1
